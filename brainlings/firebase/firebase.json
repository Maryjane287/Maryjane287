{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "family",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Permissions-Policy", "value": "microphone=(self)" }
        ]
      }
    ]
  }
}
